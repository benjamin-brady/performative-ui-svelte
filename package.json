{
	"name": "performative-ui-svelte",
	"version": "0.1.0",
	"private": false,
	"description": "AI-native Svelte 5 components that signal how oversubscribed your funding round is. A Svelte port of vorpus/performative-ui.",
	"license": "MIT",
	"type": "module",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/benjamin-brady/performative-ui-svelte.git"
	},
	"homepage": "https://benjamin-brady.github.io/performative-ui-svelte/",
	"bugs": {
		"url": "https://github.com/benjamin-brady/performative-ui-svelte/issues"
	},
	"keywords": [
		"svelte",
		"sveltekit",
		"components",
		"ai",
		"landing-page",
		"parody",
		"design-system"
	],
	"sideEffects": [
		"**/*.css"
	],
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./styles.css": "./dist/styles/pui.css"
	},
	"files": [
		"dist",
		"!dist/docs",
		"README.md",
		"LICENSE",
		"NOTICE"
	],
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"package": "svelte-kit sync && svelte-package",
		"preview": "vite preview",
		"prepare": "svelte-kit sync && svelte-package || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"registry:build": "bun scripts/build-registry.ts"
	},
	"peerDependencies": {
		"svelte": "^5.0.0",
		"tailwindcss": "^4.0.0"
	},
	"devDependencies": {
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.57.0",
		"@sveltejs/package": "^2.5.8",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@tailwindcss/vite": "^4.3.0",
		"@types/node": "^24.10.1",
		"svelte": "^5.55.2",
		"svelte-check": "^4.4.6",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.2",
		"vite": "^8.0.7"
	},
	"dependencies": {
		"bits-ui": "^2.18.1",
		"clsx": "^2.1.1",
		"esm-env": "^1.2.2",
		"runed": "^0.37.1",
		"tailwind-merge": "^3.6.0",
		"tailwind-variants": "^3.2.2"
	}
}
