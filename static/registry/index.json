{
  "$schema": "https://shadcn-svelte.com/schema/registry.json",
  "name": "performative-ui-svelte",
  "homepage": "https://benjamin-brady.github.io/performative-ui-svelte/",
  "aliases": {
    "components": "$lib/components",
    "utils": "$lib/utils",
    "hooks": "$lib/hooks",
    "styles": "$lib/styles",
    "css": "src/app.css",
    "lib": "$lib"
