    {
      "path": "src/lib/components/MockIDE.svelte",
      "target": "~/src/lib/components/MockIDE.svelte",
      "type": "registry:ui",
      "content": "<script lang=\"ts\" module>\n\timport type { Snippet } from 'svelte';\n\timport type { HTMLAttributes } from 'svelte/elements';\n\n\texport type IdeTokenClass = 'key' | 'str' | 'num' | 'com' | 'fn' | '';\n\texport interface IdeToken {\n\t\t/** Raw source text including whitespace. */\n\t\tc: string;\n\t\t/** Token class for syntax color. Empty string for plain. */\n\t\tcls?: IdeTokenClass;\n\t}\n\n\texport { default as MockIDEChrome } from './MockIDEChrome.svelte';\n\texport { default as MockIDEBody } from './MockIDEBody.svelte';\n\n\texport interface MockIDEProps extends HTMLAttributes<HTMLDivElement> {\n\t\t/** Filename shown in the tab. */\n\t\tfilename?: string;\n\t\t/** Tokens to type out (in order). If omitted, renders an empty body. */\n\t\ttokens?: IdeToken[];\n\t\t/** Loop after finishing. */\n\t\tloop?: boolean;\n\t\t/** ms range per character. */\n\t\tcharMs?: [number, number];\n\t\t/** Label for the \"AI is writing…\" pill. Pass false to hide. */\n\t\tthinkingLabel?: string | Snippet | false;\n\t\tchildren?: Snippet;\n\t}\n</script>\n\n<script lang=\"ts\">\n\timport { cn } from '$lib/utils/cn';\n\timport MockIDEBody from './MockIDEBody.svelte';\n\timport MockIDEChrome from './MockIDEChrome.svelte';\n\n\tlet {\n\t\tfilename,\n\t\ttokens,\n\t\tloop = true,\n\t\tcharMs = [14, 42],\n\t\tthinkingLabel = 'AI is writing…',\n\t\tclass: className,\n\t\tchildren,\n\t\t...rest\n\t}: MockIDEProps = $props();\n</script>\n\n<div data-slot=\"mock-ide\" data-theme=\"dark\" class={cn('overflow-hidden rounded-[var(--pui-radius)] border border-pui-border-bright bg-[#0a0a10] font-mono shadow-[0_30px_80px_oklch(0_0_0/0.55),0_0_60px_oklch(0.541_0.251_293/0.18)]', className)} {...rest}>\n\t{#if children}\n\t\t{@render children()}\n\t{:else}\n\t\t<MockIDEChrome {filename} thinking={thinkingLabel} />\n\t\t<MockIDEBody tokens={tokens ?? []} {loop} {charMs} />\n\t{/if}\n</div>\n"
    },
    {
      "path": "src/lib/components/MockIDEChrome.svelte",
      "target": "~/src/lib/components/MockIDEChrome.svelte",
      "type": "registry:ui",
      "content": "<script lang=\"ts\" module>\n\timport type { Snippet } from 'svelte';\n\timport type { HTMLAttributes } from 'svelte/elements';\n\n\texport interface MockIDEChromeProps extends HTMLAttributes<HTMLDivElement> {\n\t\tfilename?: string;\n\t\tthinking?: string | Snippet | false;\n\t\tchildren?: Snippet;\n\t}\n</script>\n\n<script lang=\"ts\">\n\timport { cn } from '$lib/utils/cn';\n\n\tlet { filename, thinking, class: className, children, ...rest }: MockIDEChromeProps = $props();\n</script>\n\n<div data-slot=\"mock-ide-chrome\" class={cn('flex items-center gap-2 border-b border-pui-border bg-[#11111a] px-3.5 py-2.5 text-xs text-pui-fg-mute', className)} {...rest}>\n\t<span data-slot=\"mock-ide-dot\" class=\"inline-block size-[11px] rounded-full bg-[#ff5f56]\"></span>\n\t<span data-slot=\"mock-ide-dot\" class=\"inline-block size-[11px] rounded-full bg-[#ffbd2e]\"></span>\n\t<span data-slot=\"mock-ide-dot\" class=\"inline-block size-[11px] rounded-full bg-[#27c93f]\"></span>\n\t{#if filename}<span data-slot=\"mock-ide-tab\" class=\"ml-2 rounded-md bg-[#1a1a26] px-2.5 py-[3px] text-pui-fg-dim\">{filename}</span>{/if}\n\t{@render children?.()}\n\t{#if thinking !== false}\n\t\t<span data-slot=\"mock-ide-thinking\" class=\"ml-auto inline-flex items-center gap-1.5 text-[11px] text-pui-fg-dim\">\n\t\t\t<span class=\"inline-block size-2.5 animate-[pui-spin_0.9s_linear_infinite] rounded-full border-[1.5px] border-white/20 border-t-pui-grad-mid\"></span>\n\t\t\t<span>{#if typeof thinking === 'string'}{thinking}{:else}{@render thinking?.()}{/if}</span>\n\t\t</span>\n\t{/if}\n</div>\n"
    },
    {
      "path": "src/lib/components/MockIDEBody.svelte",
      "target": "~/src/lib/components/MockIDEBody.svelte",
      "type": "registry:ui",
      "content": "<script lang=\"ts\" module>\n\timport type { HTMLAttributes } from 'svelte/elements';\n\timport type { IdeToken } from './MockIDE.svelte';\n\n\texport interface MockIDEBodyProps extends HTMLAttributes<HTMLPreElement> {\n\t\ttokens: IdeToken[];\n\t\tloop?: boolean;\n\t\tcharMs?: [number, number];\n\t}\n</script>\n\n<script lang=\"ts\">\n\timport { cn } from '$lib/utils/cn';\n\n\tlet { tokens, loop = true, charMs = [14, 42], class: className, ...rest }: MockIDEBodyProps = $props();\n\n\tlet preRef: HTMLPreElement | undefined = $state();\n\tlet tick = $state(0);\n\n\t$effect(() => {\n\t\ttick;\n\t\tconst el = preRef;\n\t\tif (!el || !tokens.length) return;\n\t\tlet cancelled = false;\n\t\tlet timer: ReturnType<typeof setTimeout> | null = null;\n\t\tlet tokenIdx = 0;\n\t\tlet charIdx = 0;\n\n\t\tconst caret = '<span data-slot=\"mock-ide-caret\" class=\"inline-block h-3.5 w-2 animate-[pui-caret_1s_steps(2,start)_infinite] bg-pui-grad-mid align-[-2px] shadow-[0_0_8px_var(--pui-grad-mid)]\"></span>';\n\t\tconst escape = (s: string) =>\n\t\t\ts.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\n\n\t\tconst run = () => {\n\t\t\tif (cancelled) return;\n\t\t\tif (tokenIdx >= tokens.length) {\n\t\t\t\tif (loop) {\n\t\t\t\t\ttimer = setTimeout(() => {\n\t\t\t\t\t\ttokenIdx = 0;\n\t\t\t\t\t\tcharIdx = 0;\n\t\t\t\t\t\tel.innerHTML = caret;\n\t\t\t\t\t\ttick += 1;\n\t\t\t\t\t\trun();\n\t\t\t\t\t}, 3000);\n\t\t\t\t}\n\t\t\t\treturn;\n\t\t\t}\n\t\t\tconst tok = tokens[tokenIdx];\n\t\t\tcharIdx += 1;\n\t\t\tif (charIdx > tok.c.length) {\n\t\t\t\ttokenIdx += 1;\n\t\t\t\tcharIdx = 0;\n\t\t\t\trun();\n\t\t\t\treturn;\n\t\t\t}\n\t\t\tlet html = '';\n\t\t\tfor (let k = 0; k < tokenIdx; k++) {\n\t\t\t\tconst t = tokens[k];\n\t\t\t\thtml += t.cls ? `<span data-token=\"${t.cls}\">${escape(t.c)}</span>` : escape(t.c);\n\t\t\t}\n\t\t\tconst partial = tok.c.slice(0, charIdx);\n\t\t\thtml += tok.cls ? `<span data-token=\"${tok.cls}\">${escape(partial)}</span>` : escape(partial);\n\t\t\thtml += caret;\n\t\t\tel.innerHTML = html;\n\t\t\tconst [lo, hi] = charMs;\n\t\t\tconst ms = lo + Math.random() * (hi - lo) + (partial.endsWith('\\n') ? 120 : 0);\n\t\t\ttimer = setTimeout(run, ms);\n\t\t};\n\t\tel.innerHTML = caret;\n\t\trun();\n\t\treturn () => {\n\t\t\tcancelled = true;\n\t\t\tif (timer) clearTimeout(timer);\n\t\t};\n\t});\n</script>\n\n<pre bind:this={preRef} data-slot=\"mock-ide-body\" class={cn('m-0 min-h-[280px] whitespace-pre-wrap px-[26px] py-[22px] font-mono text-[13px] leading-[1.65] text-[#d5d5e0] [&_[data-token=com]]:italic [&_[data-token=com]]:text-[#6b7280] [&_[data-token=fn]]:text-[#60a5fa] [&_[data-token=key]]:text-[#c084fc] [&_[data-token=num]]:text-[#fbbf24] [&_[data-token=str]]:text-[#6ee7b7]', className)} {...rest}></pre>\n"
    }
  ]
