{
  "$schema": "https://shadcn-svelte.com/schema/registry-item.json",
  "name": "glass-card",
  "type": "registry:ui",
  "title": "GlassCard",
  "description": "Glassmorphic card shell and compound content pieces.",
  "registryDependencies": [
    "utils",
    "theme",
    "pui-styles"
  ],
  "categories": [
    "Surfaces"
