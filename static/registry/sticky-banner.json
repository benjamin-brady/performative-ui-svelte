{
  "$schema": "https://shadcn-svelte.com/schema/registry-item.json",
  "name": "sticky-banner",
  "type": "registry:ui",
  "title": "StickyBanner",
  "description": "Sticky announcement banner for funding news and beta badges.",
  "registryDependencies": [
    "utils",
    "theme",
    "pui-styles",
    "sparkle"
  ],
  "categories": [
    "Banners"
  ],
  "files": [
    {
      "path": "src/lib/components/StickyBanner.svelte",
      "target": "$lib/components/StickyBanner.svelte",
      "type": "registry:ui",
      "content": "<script lang=\"ts\" module>\n\timport type { Snippet } from 'svelte';\n\timport type { HTMLAttributes } from 'svelte/elements';\n\n\texport interface StickyBannerProps extends HTMLAttributes<HTMLDivElement> {\n\t\t/** Hide the leading sparkle. */\n\t\thideSparkle?: boolean;\n\t\t/** Optional trailing accessory (e.g. an arrow). */\n\t\ttrailing?: Snippet;\n\t\tchildren?: Snippet;\n\t}\n</script>\n\n<script lang=\"ts\">\n\timport { cn } from '$lib/utils/cn';\n\timport Sparkle from './Sparkle.svelte';\n\n\tlet { hideSparkle = false, trailing, class: className, children, ...rest }: StickyBannerProps = $props();\n</script>\n\n<div class={cn('pui-sticky-banner', className)} {...rest}>\n\t{#if !hideSparkle}<Sparkle />{/if}\n\t<span>{@render children?.()}</span>\n\t{@render trailing?.()}\n</div>\n"
    }
  ]
}
